-      - name: List artifacts
-        run: find artifacts -type f | head -50
+      - name: Flatten artifacts and generate SHA256SUMS
+        run: |
+          mkdir -p dist
+          find artifacts -type f \( -name '*.deb' -o -name '*.rpm' -o -name '*.AppImage' \) -exec cp -v {} dist/ \;
+          cd dist
+          sha256sum -- * > SHA256SUMS
+          cat SHA256SUMS
+
+      # -----------------------------------------------------------------
+      # Optional GPG signature over SHA256SUMS (opt-in via secrets).
+      # When RELEASE_GPG_PRIVATE_KEY is set, SHA256SUMS.sig is published and
+      # the installer can enforce it with WINDOWS_11_CLIPBOARD_TRUST_KEY.
+      # امضای اختیاری GPG روی SHA256SUMS (با secret فعال می‌شود). وقتی
+      # RELEASE_GPG_PRIVATE_KEY تنظیم باشد، SHA256SUMS.sig منتشر می‌شود و
+      # نصاب می‌تواند آن را با WINDOWS_11_CLIPBOARD_TRUST_KEY الزام کند.
+      # -----------------------------------------------------------------
+      - name: Sign SHA256SUMS (optional GPG)
+        env:
+          RELEASE_GPG_PRIVATE_KEY: ${{ secrets.RELEASE_GPG_PRIVATE_KEY }}
+          RELEASE_GPG_PASSPHRASE: ${{ secrets.RELEASE_GPG_PASSPHRASE }}
+        run: |
+          if [ -z "$RELEASE_GPG_PRIVATE_KEY" ]; then
+            echo "::notice::RELEASE_GPG_PRIVATE_KEY not set; publishing unsigned SHA256SUMS"
+            exit 0
+          fi
+          export GNUPGHOME="$(mktemp -d)"
+          printf '%s' "$RELEASE_GPG_PRIVATE_KEY" | gpg --batch --import
+          passphrase_args=()
+          if [ -n "$RELEASE_GPG_PASSPHRASE" ]; then
+            passphrase_args=(--pinentry-mode loopback --passphrase "$RELEASE_GPG_PASSPHRASE")
+          fi
+          gpg --batch --yes "${passphrase_args[@]}" \
+            --armor --detach-sign --output dist/SHA256SUMS.sig dist/SHA256SUMS
+          echo "::notice::SHA256SUMS.sig published; verify with WINDOWS_11_CLIPBOARD_TRUST_KEY"
+
+      - name: Install syft (SBOM generator)
+        uses: anchore/sbom-action/download-syft@e22c389904149dbc22b58101806040fa8d37a610 # v0
+
+      - name: Generate per-artifact SPDX SBOM
+        run: |
+          # One SPDX JSON per distributable artifact, named after the file.
+          # یک SBOM جدا برای هر آرتیفکت توزیع‌شدنی.
+          set -euo pipefail
+          shopt -s nullglob
+          for f in dist/*.deb dist/*.rpm dist/*.AppImage; do
+            base="$(basename "$f")"
+            echo "Scanning $base ..."
+            syft scan "file:$f" -o spdx-json > "dist/${base}.spdx.json"
+          done
+          ls -la dist/
+
+      - name: Attest build provenance (SLSA)
+        uses: actions/attest-build-provenance@96b4a1ef7235a096b17240c259729fdd70c83d45 # v2
+        with:
+          subject-path: |
+            dist/*.deb
+            dist/*.rpm
+            dist/*.AppImage
+            dist/SHA256SUMS
+            dist/SHA256SUMS.sig
+            dist/*.spdx.json
 
       - name: Create Release and Upload Assets
-        uses: softprops/action-gh-release@v3
+        uses: softprops/action-gh-release@c12583777ecdfd3be55c69cf75464299dc01057e # v3
