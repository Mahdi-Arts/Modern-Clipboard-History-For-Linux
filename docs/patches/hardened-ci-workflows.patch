+++ b/.github/workflows/ci.yml
@@ -1,22 +1,45 @@
 name: CI
 
+# Hardened quality gate — every check in this file is BLOCKING.
+# گیت کیفیت سخت‌گیرانه — تمام بررسی‌های این فایل «مسدودکننده» هستند.
+#
+# Contract (mirrored in README.md — keep both in sync):
+#   - ESLint + tsc + Prettier-clean TS, zero warnings
+#   - Frontend unit tests WITH coverage thresholds
+#   - cargo fmt + clippy -D warnings + cargo test
+#   - cargo audit / npm audit --audit-level=high / cargo-deny (no continue-on-error)
+#   - Release build + CLI smoke (--version / --help) under Xvfb
+
 on:
   push:
     branches: [master, main, develop]
   pull_request:
     branches: [master, main]
 
+permissions:
+  contents: read
+
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
 env:
   CARGO_TERM_COLOR: always
+  RUSTFLAGS: -D warnings
 
