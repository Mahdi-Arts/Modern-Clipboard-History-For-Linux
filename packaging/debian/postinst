#!/bin/sh
# Debian post-install: system-only, non-interactive setup.
# پس‌نصب Debian: تنظیمات سیستمی و غیرتعاملی.
set -e

case "$1" in
    configure)
        modprobe uinput 2>/dev/null || true
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger --subsystem-match=misc 2>/dev/null || true
        update-desktop-database /usr/share/applications 2>/dev/null || true
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        ;;
esac

# Deliberately do not add a user to the broad `input` group. The udev uaccess
# tag grants the active seat, while Setup can request a narrow /dev/uinput ACL.
# عمداً کاربر به گروه گستردهٔ input افزوده نمی‌شود؛ uaccess نشست فعال را مجاز
# می‌کند و Setup در صورت نیاز ACL محدود /dev/uinput را درخواست می‌کند.

#DEBHELPER#
