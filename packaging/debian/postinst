#!/bin/sh
set -e

case "$1" in
    configure)
        # Ensure uinput module is loaded
        modprobe uinput 2>/dev/null || true

        # Reload udev rules
        udevadm control --reload-rules 2>/dev/null || true
        udevadm trigger 2>/dev/null || true

        # Ensure input group exists
        if ! getent group input >/dev/null 2>&1; then
            groupadd input 2>/dev/null || true
        fi

        # Add the installing user to the input group
        if [ -n "$SUDO_USER" ]; then
            if ! groups "$SUDO_USER" 2>/dev/null | grep -q '\binput\b'; then
                usermod -aG input "$SUDO_USER" || true
                echo "Added $SUDO_USER to the 'input' group."
                echo "Please log out and back in for the change to take effect."
            fi
        fi

        # Update desktop database
        update-desktop-database /usr/share/applications 2>/dev/null || true

        # Update icon cache
        gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        ;;
esac

#DEBHELPER#
