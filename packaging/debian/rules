#!/usr/bin/make -f

export NODE_OPTIONS=--max-old-space-size=4096

%:
	dh $@

override_dh_auto_configure:
	@# No configure step needed

override_dh_auto_build:
	npm ci --no-audit --no-fund
	npm run tauri:build

override_dh_auto_install:
	# Binary
	install -Dm755 src-tauri/target/release/modern-clipboard-history-for-linux-bin \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/lib/modern-clipboard-history-for-linux/modern-clipboard-history-for-linux-bin
	# Wrapper script
	install -Dm755 src-tauri/bundle/linux/wrapper.sh \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/bin/modern-clipboard-history-for-linux
	# Desktop entry
	install -Dm644 src-tauri/bundle/linux/modern-clipboard-history-for-linux.desktop \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/share/applications/io.github.mahdi-arts.clipboard-history.desktop
	# Icons
	install -Dm644 src-tauri/icons/128x128.png \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/share/icons/hicolor/128x128/apps/io.github.mahdi-arts.clipboard-history.png
	install -Dm644 src-tauri/icons/icon.png \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/share/icons/hicolor/256x256/apps/io.github.mahdi-arts.clipboard-history.png
	install -Dm644 src-tauri/icons/icon.svg \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/share/icons/hicolor/scalable/apps/io.github.mahdi-arts.clipboard-history.svg
	# udev rules
	install -Dm644 src-tauri/bundle/linux/99-modern-clipboard-history-input.rules \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/etc/udev/rules.d/99-modern-clipboard-history-input.rules
	# uinput module loading
	install -d $(CURDIR)/debian/modern-clipboard-history-for-linux/etc/modules-load.d
	echo "uinput" > $(CURDIR)/debian/modern-clipboard-history-for-linux/etc/modules-load.d/modern-clipboard-history-for-linux.conf
	# AppArmor profile (complain mode — see packaging/apparmor/)
	install -Dm644 packaging/apparmor/modern-clipboard-history-for-linux \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/share/doc/modern-clipboard-history-for-linux/apparmor/modern-clipboard-history-for-linux
	install -Dm755 packaging/apparmor/install.sh \
		$(CURDIR)/debian/modern-clipboard-history-for-linux/usr/share/doc/modern-clipboard-history-for-linux/apparmor/install.sh

override_dh_auto_test:
	# Frontend unit tests do not need a display server.
	npm test -- --run

override_dh_auto_clean:
	rm -rf node_modules dist src-tauri/target
